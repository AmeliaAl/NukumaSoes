%% [ignoring loop detection]

%% ==========================================
%% MODELS (Hanya berisi Method Bisnis)
%% ==========================================

class Barang {
    + getKodeBarang()
    + getNamaLengkap()
    + cekStokTersedia()
    + ambilHargaDasar()
}

class DetailPersediaanProduk {
    + ambilStokFEFO()
    + kurangiStok()
    + cekTanggalExpired()
}

class Mitra {
    + getKodeMitra()
    + hitungTotalPiutang()
    + cekLimitPiutang()
}

class PenjualanNonKonsinyasi {
    + getNoInvoice()
    + hitungTotal()
    + refreshStatus()
    + validasiPiutang()
    + buatJurnalPenjualan()
}

class Pembayaran {
    + getKodePembayaran()
    + hitungSisaPiutang()
    + buatJurnalPembayaran()
}

class PenjualanKonsinyasi {
    + generateNo()
    + hitungTotalPenjualan()
    + refreshStatus()
    + buatJurnalPenjualan()
}

class LaporanKonsinyasi {
    + generateNo()
    + refreshTotalLaporan()
    + validasiLaporan()
}

class TagihanKonsinyasi {
    + generateNo()
    + hitungSisaTagihan()
    + updateStatusPembayaran()
}

class PembayaranTagihanKonsinyasi {
    + getKodePembayaran()
    + buatJurnalPembayaran()
}

class JurnalUmum {
    + getTotal()
    + postingJurnal()
    + hitungSaldo()
}

class Coa {
    + getKodeAkun()
    + cekSaldoNormal()
}

class SaldoAwal {
    + generateSaldoAwal()
    + hitungSaldoPeriode()
}

%% ==========================================
%% RESOURCES & RELATION MANAGERS (Berisi Atribut & Method UI)
