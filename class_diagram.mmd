%% ==========================================
%% RELATIONSHIPS
%% ==========================================

Mitra "1" --> "*" PenjualanNonKonsinyasi : melakukan
PenjualanNonKonsinyasi "1" --> "1..*" DetailPenjualanNonKonsinyasi : terdiri_dari
DetailPenjualanNonKonsinyasi "0..*" --> "1" Barang : menggunakan
PenjualanNonKonsinyasi "1" --> "0..*" Pembayaran : dibayar via

Mitra "1" --> "*" PenjualanKonsinyasi : melakukan
PenjualanKonsinyasi "1" --> "1..*" DetailKonsinyasi : terdiri_dari
DetailKonsinyasi "0..*" --> "1" Barang : menggunakan

PenjualanKonsinyasi "1" --> "0..*" LaporanKonsinyasi : dilaporkan via
LaporanKonsinyasi "1" --> "1" TagihanKonsinyasi : menghasilkan
TagihanKonsinyasi "1" --> "0..*" PembayaranTagihanKonsinyasi : dibayar via

DetailPersediaanProduk "*" --> "1" Barang : berasal_dari
DetailPersediaanProduk --> DetailPenjualanNonKonsinyasi : mengurangi_stok
DetailPersediaanProduk --> DetailKonsinyasi : mengurangi_stok

PenjualanNonKonsinyasi --> JurnalUmum : membuat_jurnal
PenjualanKonsinyasi --> JurnalUmum : membuat_jurnal
Pembayaran --> JurnalUmum : membuat_jurnal
PembayaranTagihanKonsinyasi --> JurnalUmum : membuat_jurnal
SaldoAwal --> JurnalUmum : membentuk_saldo
JurnalUmum "*" --> "1" Coa : terkait_akun

%% Relasi Manajemen (Resource/RelationManager -> Model)
BarangResource ..> Barang : kelola_data
MitraResource ..> Mitra : kelola_data
PenjualanNonKonsinyasiResource ..> PenjualanNonKonsinyasi : kelola_transaksi
PembayaranResource ..> Pembayaran : kelola_pembayaran
PenjualanKonsinyasiResource ..> PenjualanKonsinyasi : kelola_transaksi
LaporanKonsinyasiResource ..> LaporanKonsinyasi : kelola_laporan
TagihanKonsinyasiResource ..> TagihanKonsinyasi : kelola_tagihan
PembayaranTagihanKonsinyasiResource ..> PembayaranTagihanKonsinyasi : kelola_pembayaran
JurnalUmumResource ..> JurnalUmum : kelola_jurnal
CoaResource ..> Coa : kelola_coa
SaldoAwalResource ..> SaldoAwal : kelola_saldo
